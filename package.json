{
  "name": "vulnerable-express-app",
  "version": "1.0.0",
  "description": "An intentionally vulnerable Express.js application for security testing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "mocha test/**/*.js"
  },
  "dependencies": {
    "express": "^4.17.1",
    "body-parser": "^1.19.0",
    "cookie-parser": "^1.4.5",
    "express-fileupload": "1.1.6",
    "jsonwebtoken": "8.5.1",
    "lodash": "4.17.19",
    "request": "2.88.0",
    "xml2js": "0.4.19",
    "ejs": "2.7.4",
    "serialize-javascript": "3.1.0",
    "dotenv": "8.2.0",
    "multer": "2.0.0",
    "morgan": "1.9.1",
    "validator": "10.8.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.4",
    "mocha": "^8.0.1",
    "chai": "^4.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/example/vulnerable-express-app"
  },
  "keywords": [
    "vulnerable",
    "security",
    "testing",
    "express"
  ],
  "author": "Security Test Team",
  "license": "MIT",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "99.0.0",
      "onFail": "error"
    }
  }
}
